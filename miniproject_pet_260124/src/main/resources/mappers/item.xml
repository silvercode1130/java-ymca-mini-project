<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.db.dao.ItemDao">
	<select id="getItemList" resultType="com.example.db.vo.item">
        SELECT * FROM item ORDER BY item_idx DESC
    </select>
    
    <select id="getItemDetail" resultType="com.example.db.vo.item">
    	SELECT * FROM item WHERE item_idx = #{item_idx}
    </select>
    
    <select id="searchItem"  resultType="com.example.db.vo.item">
	    SELECT * FROM item WHERE item_name LIKE '%' || #{searchKeyword} || '%'
	</select>
	
	<select id="getItemByCategory" resultType="com.example.db.vo.item">
	    SELECT * FROM item WHERE item_category LIKE '%' || #{category} || '%' ORDER BY item_idx DESC
	</select>
</mapper>












