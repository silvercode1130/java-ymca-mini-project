			#{mem_grade_idx} ,
			#{mem_bday} ,
			default ,
			default ,
			#{mem_deldate}
		)
	</insert> -->

	<!-- 수정 -->
	<update id="update" parameterType="member">
		update member set
			mem_id =#{mem_id},
			mem_pwd =#{mem_pwd},
			mem_name =#{mem_name},
			mem_tel =#{mem_tel},
			mem_email =#{mem_email},
			mem_ip =#{mem_ip},
			mem_role_idx =#{mem_role_idx},
			mem_grade_idx =#{mem_grade_idx},
			mem_bday =#{mem_bday},
			mem_ip =#{mem_ip},
			mem_role =#{mem_role}
			where mem_idx=#{mem_idx}
	</update>

	<!-- 삭제 -->
	<delete id="delete" parameterType="int">
		delete from member where mem_idx=#{ mem_idx }
	</delete>
</mapper>












